# bun run build 默认把项目根目录 .env 内嵌为缺省配置，不需要复制到每个工作目录。
# 优先级：shell 环境变量 > 启动目录 dotenv 配置 > 内嵌配置 > 程序默认值。
# 内嵌值按字面值解析（不展开 $VAR）；更改后须重新 build。
# 内嵌不是加密；公开分发使用 bun run build -- --no-embed-env。
# 对外地址：公网部署必须是 https（需要 TLS 终止），否则构建/启动会被拒绝。
# 仅 localhost / 127.0.0.1 / ::1 可用 http；内网/隧道调试可用
# PI_MCP_ALLOW_INSECURE_BASE_URL=1 放行明文 http。
BASE_URL=https://mcp.example.com
PORT=3000

# 登录密码：至少 12 位，且覆盖大小写、数字、符号中的至少 3 类。
# 留空或使用弱密码（含内置默认值 pi-mcp）会导致构建和启动被直接拒绝。
# 生成：openssl rand -base64 24
# 本地开发确需弱密码时设置 PI_MCP_ALLOW_WEAK_PASSWORD=1。
LOGIN_PASSWORD=

# 日志：debug | info | warn | error（默认 info）；LOG_REQUESTS=0 关掉每个请求一行
LOG_LEVEL=info
LOG_REQUESTS=1
# auto：交互终端用 Pi TUI，管道/systemd 用普通日志；plain 关闭；tui 显式启用
LOG_UI=auto
# TUI 保留的已完成任务数量（1–2000）；运行中任务不淘汰
LOG_TUI_HISTORY=200
# Pi 内置主题：dark / light，也支持 Pi 已安装的自定义主题
LOG_TUI_THEME=dark
# 点击展开后显示工具返回的图片（使用 Pi 自动检测的终端图像协议）；0 关闭图片
LOG_TUI_IMAGES=1
# 原始输入/输出只保留在内存；每次调用各保留最近约 1 Mi 字符（4 Ki–4 Mi）
LOG_TUI_OUTPUT_CHARS=1048576
# 卡片正文始终默认折叠，点击展开，不按敏感文件名或凭据内容脱敏。
# 旧 LOG_TOOL_PREVIEW_CHARS 不再控制 TUI 的原文查看。

# 本地调试时可设为 1，跳过 consent 页面直接发 code（仍需先登录）
OAUTH_AUTO_APPROVE=0

# ---- 以下均为可选 ----
# OAUTH_JWK='{"kty":"RSA","kid":"...","n":"...","e":"...","d":"..."}'
# OAuth 状态默认按运行用户全局共享，不写入项目目录；父目录在需要时自动创建。
# 默认：~/.pi-mcp/.oauth-jwk.json 和 ~/.pi-mcp/.oauth-store.json
# 同一服务跨项目启动无需配置；独立服务可指定不同目录（支持 ~）。
# PI_MCP_STATE_DIR=~/.pi-mcp
# 文件级覆盖优先于状态目录；显式相对路径仍相对启动 cwd，通常保持下面两项未设置。
# OAUTH_JWK_FILE=~/.pi-mcp/.oauth-jwk.json
# OAUTH_STORE_FILE=~/.pi-mcp/.oauth-store.json
# SESSION_TTL=604800
# ACCESS_TOKEN_TTL=3600
# AUTH_CODE_TTL=300
# REFRESH_TOKEN_TTL=2592000

# ---- pi coding agent ----
# 工作目录：默认取进程启动时的 cwd（在哪个目录启动就在哪干活），也可显式覆盖（支持 ~）
# 希望工作目录随启动位置变化时，不要在内嵌配置中设置固定的 PI_MCP_CWD。
# PI_MCP_CWD=/path/to/workspace
# 通过 MCP 暴露哪些 pi 内置工具（逗号分隔），默认 5 个经典工具；可选 find、ls
# PI_MCP_TOOLS=read,bash,edit,write,grep
